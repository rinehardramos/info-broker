# info-broker environment configuration
# Copy to .env and fill in values.

# REST API auth — required. Clients must send this in X-API-Key header.
INFO_BROKER_API_KEY=replace-with-a-strong-random-string

# PlayGen callback base URL (info-broker POSTs audio-sourcing results here)
PLAYGEN_INTERNAL_URL=https://api.playgen.site

# Postgres
POSTGRES_DB=info_broker
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6335

# Local LLM (LM Studio / Ollama compatible)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
CHAT_MODEL_NAME=local-model
EMBEDDING_MODEL_NAME=local-embed

# Apify dataset URL for /ingest
APIFY_DATASET_URL=https://api.apify.com/v2/datasets/<id>/items?format=json

# S3-compatible storage (Cloudflare R2) — used by POST /v1/playlists/source-audio.
# Bucket: ownradio  |  Endpoint: Cloudflare R2 account endpoint
S3_BUCKET=ownradio
S3_ENDPOINT=https://fa958caa19c273f07b49c49a09d76a60.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key

# ---------------------------------------------------------------------------
# platform-monitoring (Phase 1 — capture + read-only dashboard)
# ---------------------------------------------------------------------------

# Master switch. Set to false to disable middleware + worker entirely (app still starts).
MONITORING_ENABLED=true

# ClickHouse DSN — used by monitoring-worker and the query router.
# In Docker Compose the hostname is "clickhouse" (service name).
CLICKHOUSE_URL=http://default:@clickhouse:8123

# Dedicated monitoring Redis (separate from the app's allkeys-lru cache).
# --maxmemory-policy noeviction so denylist/counters are never silently dropped.
# In Docker Compose the hostname is "monitoring-redis".
MONITORING_REDIS_URL=redis://monitoring-redis:6379/0

# Path to the GeoLite2-City.mmdb file inside the container.
# Mount the host copy via volumes in docker-compose.yml (see Task 3).
GEOLITE2_DB_PATH=/opt/geolite2/GeoLite2-City.mmdb

# Raw mon.requests TTL in days (rows older than this are deleted by ClickHouse TTL).
MON_RAW_RETENTION_DAYS=30

# CIDRs whose forwarded headers (CF-Connecting-IP, X-Forwarded-For) are trusted.
# Set to Cloudflare's published IP ranges when the tunnel is active.
# For local dev without a tunnel, leave empty or set to 127.0.0.1/32.
MON_TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22

# fail-open (default) or fail-closed when the monitoring HotStore is unreachable.
MON_ENFORCEMENT_FAIL_MODE=open

# Redis stream cap (approximate). Default 1 million entries.
MON_STREAM_MAXLEN=1000000

# Optional alert webhook — POST JSON with HMAC-signed X-Mon-Signature header.
MON_ALERT_WEBHOOK_URL=
MON_ALERT_WEBHOOK_SECRET=
